# Copy this file to .env and fill in your own values

# MongoDB connection string.
# Easiest option: create a free cluster at https://www.mongodb.com/cloud/atlas
# and paste the connection string it gives you here.
MONGO_URI=mongodb://127.0.0.1:27017/marblehub

# Port the API server runs on
PORT=5000

# Demo admin login (used by the Admin panel on the website)
ADMIN_USER=admin
ADMIN_PASS=marble123

# Any random long string - used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Frontend URL, for CORS
CLIENT_URL=http://localhost:5173
