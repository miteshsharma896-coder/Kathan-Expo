# Copy this file to .env and fill in your own values

# MongoDB connection string.
# Easiest option: create a free cluster at https://www.mongodb.com/cloud/atlas
# and paste the connection string it gives you here.
MONGO_URI=mongodb://127.0.0.1:27017/marblehub

# Port the API server runs on
PORT=5000

# Demo admin login (used by the Admin panel on the website)
ADMIN_USER=admin
ADMIN_PASS=marble123

# Any random long string - used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Email notifications (Nodemailer via Gmail)
# MAIL_USER = your Gmail address (e.g. yourname@gmail.com)
# MAIL_PASS = Gmail App Password (16-char code — NOT your normal password)
#
# How to create a Gmail App Password:
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification (if not already on)
#   3. Under 2-Step Verification, click "App passwords"
#   4. Select app: Mail | device: Other → type "Yatharth Stones" → Generate
#   5. Copy the 16-character code → paste below as MAIL_PASS
#
# Leave both blank to disable email notifications (quotes still save to DB)
MAIL_USER=
MAIL_PASS=

# Frontend URL, for CORS
CLIENT_URL=http://localhost:5173

# Your real website's URL once deployed (used by the sitemap generator).
# No trailing slash. Leave as-is until you have a real domain.
SITE_URL=https://www.yourdomain.com
