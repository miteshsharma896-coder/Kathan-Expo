<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLACEHOLDER SITEMAP - replace https://www.yourdomain.com below with your
  real domain once you've deployed, OR just run the generator script instead:

    cd backend
    npm run sitemap

  which builds this file automatically (static pages + every product,
  freshly pulled from MongoDB) using SITE_URL from backend/.env.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.yourdomain.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/catalog</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
